import MainLayout from "../layout/MainLayout";

const Dashboard = () => {
  return (
    <MainLayout>
      <h1 className="text-2xl font-semibold mb-6">
        Dashboard
      </h1>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div className="bg-white p-6 rounded-lg shadow">
